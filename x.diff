@@ -879,6 +883,55 @@ impl Encoder {
             ));
         }
 
+        // surface.Info.Width/Height は 16 アライン済みのため、入力を同じ stride へ展開する。
+        let aligned_size = self
+            .frame_format
+            .frame_size(self.surface_w, self.surface_h)
+            .ok_or_else(|| {
+                Error::new_custom("Encoder::encode", "aligned frame size calculation overflowed")
+            })?;
+        let mut aligned_frame = vec![0u8; aligned_size];
+        match self.frame_format {
+            FrameFormat::Nv12 => {
+                let src_y_stride = self.crop_w;
+                let dst_y_stride = self.surface_w;
+                let src_uv_offset = self.crop_w * self.crop_h;
+                let dst_uv_offset = self.surface_w * self.surface_h;
+                for row in 0..self.crop_h {
+                    let src = row * src_y_stride;
+                    let dst = row * dst_y_stride;
+                    aligned_frame[dst..dst + self.crop_w]
+                        .copy_from_slice(&frame_data[src..src + self.crop_w]);
+                }
+                for row in 0..(self.crop_h / 2) {
+                    let src = src_uv_offset + row * src_y_stride;
+                    let dst = dst_uv_offset + row * dst_y_stride;
+                    aligned_frame[dst..dst + self.crop_w]
+                        .copy_from_slice(&frame_data[src..src + self.crop_w]);
+                }
+            }
+            FrameFormat::Yuy2 => {
+                let src_stride = self.crop_w * 2;
+                let dst_stride = self.surface_w * 2;
+                for row in 0..self.crop_h {
+                    let src = row * src_stride;
+                    let dst = row * dst_stride;
+                    aligned_frame[dst..dst + src_stride]
+                        .copy_from_slice(&frame_data[src..src + src_stride]);
+                }
+            }
+            FrameFormat::Bgra => {
+                let src_stride = self.crop_w * 4;
+                let dst_stride = self.surface_w * 4;
+                for row in 0..self.crop_h {
+                    let src = row * src_stride;
+                    let dst = row * dst_stride;
+                    aligned_frame[dst..dst + src_stride]
+                        .copy_from_slice(&frame_data[src..src + src_stride]);
+                }
+            }
+        }
+
         // mfxFrameSurface1 を設定する
         let mut surface: sys::mfxFrameSurface1 = unsafe { std::mem::zeroed() };
         surface.Info = self.frame_info;
